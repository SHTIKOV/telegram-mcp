TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Prefer a local session file (created by login script):
TELEGRAM_SESSION_PATH=/home/YOU/.local/state/telegram-readonly-mcp/session

# Or paste a session string instead of TELEGRAM_SESSION_PATH:
# TELEGRAM_SESSION_STRING=

# Required. Comma-separated chat ids and/or @usernames. Fail-closed.
TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890,@your_group
